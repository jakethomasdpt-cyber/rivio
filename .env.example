# Neon (runtime role; keep the owner connection out of deployed environments)
DATABASE_URL=postgresql://rivio_app:password@your-host-pooler.neon.tech/neondb?sslmode=verify-full
# Direct owner connection, for migration tooling only
DATABASE_URL_UNPOOLED=postgresql://owner:password@your-host.neon.tech/neondb?sslmode=verify-full

# Better Auth (generate a random secret of at least 32 characters)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3002
AUTH_EMAIL_FROM=Rivio <invoices@physicaltherapy365.com>

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...

# App URL (update to your production domain after deploying)
NEXT_PUBLIC_APP_URL=http://localhost:3002
